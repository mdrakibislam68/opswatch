# ─── Application ───────────────────────────────────────────
NODE_ENV=production
PORT=4000

# ─── JWT ────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_string_in_production

# ─── Database ───────────────────────────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_USER=opswatch
DB_PASS=opswatch_secret
DB_NAME=opswatch

# ─── Redis ──────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_secret

# ─── Frontend URL (CORS) ────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ─── Public API URL (SSH agent install) ─────────────────────
# URL that remote servers use to download the agent binary and phone home.
# Must be reachable FROM the remote host — do not use localhost unless the
# agent is installed on the same machine as the API.
# Examples:
#   PUBLIC_API_URL=http://192.168.0.210:4000/api/v1
#   PUBLIC_API_URL=https://opswatch.example.com/api/v1
PUBLIC_API_URL=http://localhost:4000/api/v1

# ─── SMTP (Email alerts) ────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password

# ─── Telegram (Bot alerts) ──────────────────────────────────
TELEGRAM_BOT_TOKEN=123456789:ABCDEFxxxxxxxxxxxxxxxxxxxxxx
